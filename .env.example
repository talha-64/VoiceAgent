# ==========================================
# Groq API Configuration
# Get your API key from: https://console.groq.com/keys
# ==========================================
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: override the Groq model (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# ==========================================
# Vapi Configuration
# Get your keys from: https://dashboard.vapi.ai
# ==========================================
VAPI_PUBLIC_KEY=your_vapi_public_key_here
VAPI_PRIVATE_KEY=your_vapi_private_key_here

# Optional: Default Vapi Assistant ID (if using an existing assistant)
VAPI_ASSISTANT_ID=your_assistant_id_here

# ==========================================
# Server Configuration
# ==========================================
PORT=8000
HOST=0.0.0.0

# ==========================================
# Security (recommended before exposing via ngrok)
# ==========================================
# Shared secret Vapi must send on /chat/completions and /webhook/vapi.
# In Vapi: create a Custom Credential / set the Server URL secret to this same value.
VAPI_WEBHOOK_SECRET=change_me_to_a_long_random_string

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173

# ==========================================
# Frontend Configuration (in frontend/.env)
# ==========================================
# VITE_VAPI_PUBLIC_KEY=your_vapi_public_key_here
# VITE_VAPI_ASSISTANT_ID=your_assistant_id_here
# VITE_NGROK_URL=https://your-active-subdomain.ngrok-free.dev

